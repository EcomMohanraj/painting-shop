# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real API keys.

# Resend API key (https://resend.com/api-keys) — starts with "re_"
RESEND_API_KEY=

# Where quote enquiries are emailed. Comma-separate multiple addresses.
# While using the default test sender below, this MUST be the same email
# you signed up to Resend with.
ENQUIRY_TO_EMAIL=

# Optional. Leave blank to use Resend's test sender (onboarding@resend.dev).
# After verifying your domain in Resend, set e.g.:
# ENQUIRY_FROM_EMAIL="Krisha Paintings Website <enquiries@krishapaintings.com>"
ENQUIRY_FROM_EMAIL=
