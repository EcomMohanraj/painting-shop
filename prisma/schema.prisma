// Krisha Paintings database schema (PostgreSQL on Neon).
// Connection URLs live in prisma.config.ts / .env.local, not here.
//
// After editing this file:
//   npm run db:migrate   -> create + apply a migration (development)
//   npm run db:generate  -> regenerate the TypeScript client only

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum ProjectType {
  INTERIOR
  EXTERIOR
  COMMERCIAL
  TEXTURE
  WATERPROOFING
  INDUSTRIAL
}

enum ServiceCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// ─── Portfolio ──────────────────────────────────────────────────────────────

/// A completed job shown in the before & after gallery.
model Project {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  location    String
  type        ProjectType
  /// Image URLs (e.g. /images/gallery/x.jpg or a storage/CDN URL).
  beforeImage String?
  afterImage  String?
  description String?        @db.Text
  photos      ProjectPhoto[]

  /// Optional link to the service this project showcases.
  serviceId   String?
  service     Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  featured    Boolean        @default(false)
  published   Boolean        @default(true)
  sortOrder   Int            @default(0)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([published, sortOrder])
  @@index([type])
  @@map("projects")
}

/// Additional photos for a project, beyond the before/after pair.
model ProjectPhoto {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
  @@map("project_photos")
}

// ─── Services ───────────────────────────────────────────────────────────────

model Service {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  category    ServiceCategory
  summary     String
  description String?         @db.Text
  features    String[]
  /// Icon key used by ServiceCard: home | brush | building | droplets | layers | paint
  icon        String          @default("paint")
  image       String?
  published   Boolean         @default(true)
  sortOrder   Int             @default(0)
  projects    Project[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([published, sortOrder])
  @@map("services")
}

// ─── Testimonials ───────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String?
  /// Short label for the job, e.g. "3BHK Interior Painting".
  project   String?
  /// 1–5 (validated in application code).
  rating    Int      @default(5)
  quote     String   @db.Text
  photo     String?
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("testimonials")
}

// ─── Enquiries ──────────────────────────────────────────────────────────────

/// Quote requests submitted through the website contact form.
model Enquiry {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  location     String?
  propertyType PropertyType
  /// Service name as the customer selected it (kept as text so it survives
  /// services being renamed or removed).
  service      String
  message      String?       @db.Text

  status       EnquiryStatus @default(NEW)
  /// Internal notes for follow-up (admin only).
  notes        String?       @db.Text
  emailSent    Boolean       @default(false)
  source       String        @default("website")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("enquiries")
}

// ─── Site photos ────────────────────────────────────────────────────────────

/// Standalone images not tied to a project/service/testimonial, one per slot
/// key (slots are listed in src/lib/admin-options.ts → siteImageSlots).
model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String?
  updatedAt DateTime @updatedAt

  @@map("site_images")
}
