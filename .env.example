# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real API keys.

# Resend API key (https://resend.com/api-keys) — starts with "re_"
RESEND_API_KEY=

# Where quote enquiries are emailed. Comma-separate multiple addresses.
# While using the default test sender below, this MUST be the same email
# you signed up to Resend with.
ENQUIRY_TO_EMAIL=

# Optional. Leave blank to use Resend's test sender (onboarding@resend.dev).
# After verifying your domain in Resend, set e.g.:
# ENQUIRY_FROM_EMAIL="Krisha Paintings Website <enquiries@krishapaintings.com>"
ENQUIRY_FROM_EMAIL=

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Neon dashboard → your project → Connect. Copy both strings:
# Pooled connection (host contains "-pooler") — used by the website at runtime.
DATABASE_URL=
# Direct connection (same string without "-pooler") — used for migrations.
DIRECT_URL=

# ─── Admin login (NextAuth) ─────────────────────────────────────────────────
# The single admin account. Generate the hash with:  npm run admin:hash
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Random secret that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
# The site's public URL (http://localhost:3000 locally; your real domain in production).
NEXTAUTH_URL=http://localhost:3000

# ─── Image uploads (Cloudinary) ─────────────────────────────────────────────
# Cloudinary dashboard (cloudinary.com/console) → "API Keys" page.
# Leave blank to save uploads to ./uploads instead (local dev / VPS only —
# REQUIRED on Vercel, whose disk isn't persistent).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
